APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001
SERVER_PORT=8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:5174
# index.html de la web compilada: el backend lo sirve con el texto de cada página para Google y
# las IA. En producción, la ruta absoluta de public_html/home/index.html (vacío = frontend/dist local)
WEB_INDEX_HTML=
# Aviso a la app DuaLab de cada formulario de empresa o centro → captación en Central.
# URL: https://api.dualab.es/api/integraciones/frontoffice/formularios (en local, la de Sail).
# SECRETO: el mismo que FRONTOFFICE_WEBHOOK_SECRETO en el .env de la app (openssl rand -hex 32).
APP_DUALAB_WEBHOOK_URL=
APP_DUALAB_WEBHOOK_SECRETO=
SANCTUM_STATEFUL_DOMAINS=localhost:5174

# CRM (EspoCRM): cada solicitud de los formularios por agente se envía también
# al CRM. CRM_URL vacío = integración apagada. Las claves (una por formulario)
# las genera el CRM; pedirlas a quien lo administra.
CRM_URL=
CRM_CLAVE_CENTRO=
CRM_CLAVE_EMPRESA=
CRM_CLAVE_ADMINISTRACION=

# Biblioteca de medios: sin estas variables los archivos se guardan en el disco local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=dualab/web
CMS_MEDIOS_CUOTA_MB=2048

# Correo en Gestión web (bandeja de info@ por IMAP). Sin contraseña no se sincroniza.
# La contraseña solo aquí: nunca en la BD ni en el panel.
CORREO_IMAP_HOST=imap.hostinger.com
CORREO_IMAP_PUERTO=993
CORREO_INFO_USUARIO=info@dualab.es
CORREO_INFO_PASSWORD=
# Envío (por defecto smtp.hostinger.com:465 con TLS y copia en INBOX.Sent).
# En local, a Mailpit y sin escribir en el buzón real:
# CORREO_SMTP_HOST=127.0.0.1
# CORREO_SMTP_PUERTO=1026
# CORREO_SMTP_TLS=false
# CORREO_GUARDAR_ENVIADOS=false
# CORREO_MARCAR_EN_BUZON=false
CORREO_MAX_ENVIOS_DIA=200

# DuaLab Central → «Primer contacto»: API firmada de la bandeja de formularios (mínimo 32 caracteres).
# El mismo valor va en FRONTOFFICE_CENTRAL_SECRETO del .env de la app DuaLab.
CENTRAL_API_SECRETO=
